# Copy to .env and adjust if needed:
#   cp .env.example .env
#
# Docker (recommended): docker compose up --build
#   - DATABASE_URL below is for local `uv run` only; compose overrides it to use the `db` service.
#   - Use 127.0.0.1 (not localhost) on macOS to avoid IPv6 hangs when running the API on the host.

DATABASE_URL=postgresql+asyncpg://career:career@127.0.0.1:5432/ai_career_os

# Optional API key fallbacks when not set in app Settings UI
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# AZURE_OPENAI_API_KEY=
# NVIDIA_API_KEY=

# Job discovery via JSearch on RapidAPI (required for Discover tab)
# RAPIDAPI_KEY=

# DEBUG=false

# Match RAG: retrieve relevant resume chunks before full match (default: true)
# MATCH_RAG_ENABLED=true
# MATCH_RAG_TOP_K=10
# MATCH_RAG_PER_REQUIREMENT=true
# MATCH_RAG_PER_REQUIREMENT_TOP_K=3
# MATCH_COMPACT_JOB_PROMPT=true
# MATCH_LLM_MAX_TOKENS=768  # bumped to 4096 automatically for Nemotron/gpt-oss
