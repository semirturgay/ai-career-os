{
  "manifest_version": 3,
  "name": "AI Career OS",
  "version": "0.4.0",
  "description": "Explainable job matching in your browser — capture jobs from the page DOM, review, and analyze fit.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AI Career OS"
  },
  "side_panel": {
    "default_path": "app/index.html"
  },
  "options_page": "options/options.html"
}
