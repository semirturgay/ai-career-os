{
  "name": "ai-career-os-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "bun run generate:api-types",
    "build": "tsc -b && vite build",
    "build:extension": "tsc -b && vite build --config vite.extension.config.ts --mode extension",
    "preview": "vite preview",
    "generate:api-types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/types/api.generated.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/chrome": "^0.0.320",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "openapi-typescript": "^7.8.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
